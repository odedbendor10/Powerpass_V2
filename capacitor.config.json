{
  "appId": "il.co.powerpass.app",
  "appName": "POWERPASS",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#151c36"
  },
  "plugins": {
