{
  "name": "powerpass-app",
  "version": "1.1.0",
  "private": true,
  "description": "POWERPASS – סימולטור מבחני רישוי בחשמל (אפליקציית אנדרואיד, Capacitor)",
  "scripts": {
    "postinstall": "node scripts/copy-cap.mjs",
